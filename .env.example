# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat loads it for a local run (it passes --dotenv and prints the variable names it loaded); a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# --- Access ---
# Unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
SERVICE_ADMIN_PASSWORD=
# Port the service listens on (compose: the port published by the load balancer).
SERVICE_PORT=29203

# --- Model backend: Ollama (recommended) ---
# Answers through an Ollama server with a quantised GGUF, thinking off. About 15x faster than torch on a CPU
# without AVX2. Needs Ollama 0.40.12 or newer, listening on 0.0.0.0, with the model pulled: ollama pull <model>
# From Docker the host's Ollama is http://host.docker.internal:11434; with run.bat use http://127.0.0.1:11434.
# Leave both empty to run the model in this process with torch instead.
SERVICE_OLLAMA_URL=http://host.docker.internal:11434
# Thinking: off (default) or on (the model thinks first: slower, needs a model with thinking support).
# Also on the /admin/ Settings card (applies at once).
# SERVICE_THINKING=off
# Small models sometimes write their reasoning into the answer and end it with </think>. true drops that part;
# a streamed reply is then sent in one piece when complete. false streams the model's text as it is.
# SERVICE_HIDE_REASONING=true
SERVICE_OLLAMA_MODEL=hf.co/XHToken/Spark-X2.6-1.7B-GGUF:Q4_K_M

# --- Compose ---
# API copies behind nginx. With torch each copy holds the model in RAM (about 5 GB); with Ollama they share one model.
SERVICE_REPLICAS=1
# SERVICE_MEM_LIMIT=7g

# --- Torch backend only ---
# CPU threads (set to the physical cores). A value saved on /admin/ beats this one.
# SERVICE_NUM_THREAD=4
# SERVICE_MODEL=XHToken/Spark-X2.6-1.7B
# SERVICE_DTYPE=bfloat16

# --- Tunables ---
# These are set on the /admin/ Settings card and saved in settings.json. The variables below only give run.bat a
# starting value (compose does not pass them); a saved value wins.
# SERVICE_UPDATE_CHECK_HOURS=6
# SERVICE_MAX_INFLIGHT=
# SERVICE_MAX_PROJECT_MODELS=2
# SERVICE_PROJECT_MODELS_DIR=
# SERVICE_WARM=1

# --- run.bat only (compose sets these itself) ---
# SERVICE_HOST=127.0.0.1
# SERVICE_TOKENS_FILE=tokens.json
# SERVICE_WEB_DIR=web
