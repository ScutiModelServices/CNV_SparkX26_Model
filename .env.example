# Copy to .env (git-ignored). Compose reads it; run.bat loads it with --dotenv and prints loaded names only.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env. A real environment variable wins over .env.

# Unlocks /admin/ and requires caller tokens. Empty = no auth (local use only).
SERVICE_ADMIN_PASSWORD=

# Host port published by nginx (or the local API port).
SERVICE_PORT=29203

# Running Ollama is required. Compose defaults to this host address; for a local run use http://127.0.0.1:11434.
# An explicitly empty URL is an error. Pull the model into Ollama before calling the API.
SERVICE_OLLAMA_URL=http://host.docker.internal:11434

# Model selected at startup; pull with: ollama pull hf.co/XHToken/Spark-X2.6-1.7B-GGUF:Q4_K_M
SERVICE_OLLAMA_MODEL=hf.co/XHToken/Spark-X2.6-1.7B-GGUF:Q4_K_M

# API copies share one Ollama model.
SERVICE_REPLICAS=1
# API memory cap only; Ollama manages model memory separately.
# SERVICE_MEM_LIMIT=0

# Local-run bind address (Compose sets this itself).
# SERVICE_HOST=127.0.0.1
