# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# --- Access ---
# Unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
SPARK_ADMIN_PASSWORD=
# Port the service listens on (compose: the port published by the load balancer).
SPARK_PORT=9180

# --- Model backend: Ollama (recommended) ---
# Answers through an Ollama server with a quantised GGUF, thinking off. About 15x faster than torch on a CPU
# without AVX2. Needs Ollama 0.40.12 or newer, listening on 0.0.0.0, with the model pulled: ollama pull <model>
# From Docker the host's Ollama is http://host.docker.internal:11434; with run.bat use http://127.0.0.1:11434.
# Leave both empty to run the model in this process with torch instead.
SPARK_OLLAMA_URL=http://host.docker.internal:11434
SPARK_OLLAMA_MODEL=hf.co/XHToken/Spark-X2.6-1.7B-GGUF:Q4_K_M

# --- Compose ---
# API copies behind nginx. With torch each copy holds the model in RAM (about 5 GB); with Ollama they share one model.
SPARK_REPLICAS=1
# SPARK_MEM_LIMIT=7g

# --- Torch backend only ---
# CPU threads (set to the physical cores). A value saved on /admin/ beats this one.
# SPARK_NUM_THREAD=4
# SPARK_MODEL=XHToken/Spark-X2.6-1.7B
# SPARK_DTYPE=bfloat16

# --- Tunables ---
# These are set on the /admin/ Settings card and saved in settings.json. The variables below only give run.bat a
# starting value (compose does not pass them); a saved value wins.
# SPARK_UPDATE_CHECK_HOURS=6
# SPARK_MAX_INFLIGHT=
# SPARK_MAX_PROJECT_MODELS=2
# SPARK_PROJECT_MODELS_DIR=
# SPARK_WARM=1

# --- run.bat only (compose sets these itself) ---
# SPARK_HOST=127.0.0.1
# SPARK_TOKENS_FILE=tokens.json
# SPARK_WEB_DIR=web
